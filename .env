# ==========================================
# Qwen3-ASR Configuration (Environment Variables)
# ==========================================

# -----------------
# Compose & Network
# -----------------
HOST=0.0.0.0
PORT=8766

# -----------------
# Core Behavior
# -----------------
# 空闲卸载秒数。0 = 常驻，实时结束后立刻离线不必重新加载。
UNLOAD_GRACE_S=0
REQUEST_TIMEOUT=300
# WebSocket 实时识别用 0：消除随机采样导致的 partial 抖动。
WS_ASR_TEMPERATURE=0.0

# -----------------
# Local GGUF / ONNX models
# -----------------
# 所有模型文件的根目录（相对路径基于项目根目录，也支持绝对路径）。
MODEL_DIR=E:\cursorProject\stt-qwen3\models
LLM_FN=qwen3_asr_llm.q5_k.gguf
ENCODER_FRONTEND_FN=qwen3_asr_encoder_frontend.int8.onnx
ENCODER_BACKEND_FN=qwen3_asr_encoder_backend.int8.onnx
ONNX_PROVIDER=DML

# -----------------
# Logging
# -----------------
LOG_LEVEL=INFO
LOG_DIR=./logs

# -----------------
# WebSocket Streaming（一次连接只转一段音频）
# -----------------
WS_PARTIAL_SECONDS=0.8
# 累计 16k PCM 上限（秒），到点 final 后断开。最大 60。
WS_MAX_AUDIO_SECONDS=60
# 后端点：说话后连续静音这么久 → 认为音频结束，final 后断开。
WS_EOS_SILENCE_MS=600
# committed 后静音这么久开始投机跑 final（叠进 EOS 等待）。0=关。开口会 cancel。
WS_SPECULATIVE_FINAL_MS=300
# 满 8s 窗文本冻结：音频超过窗尾这么多 ms 才 commit（避免 8.00s last-flush 与后续非 last 不一致）。
WS_CHUNK_COMMIT_MARGIN_MS=400
WS_EARLY_SILENCE_MS=1000
WS_VAD_PRE_ROLL_MS=400
ASR_USE_SERVER_VAD=true
VAD_MODEL_PATH=silero_vad.onnx

# -----------------
# Hardware Acceleration
# -----------------
LLM_USE_GPU=true
#GGML_VK_DISABLE_F16=1

# -----------------
# Hotword Correction (音素级热词纠错)
# -----------------
HOTWORD_ENABLED=true
HOTWORDS_PATH=E:\cursorProject\lingting\data\hotwords.txt
HOTWORD_THRESHOLD=0.85
